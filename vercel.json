{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build && cd ../backend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "echo 'skip default install'",
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/dist/**,backend/src/db/schema.sql,backend/node_modules/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "env": {
    "NODE_ENV": "production",
    "VERCEL": "1",
    "DB_PATH": "/tmp/oee_platform.db",
    "JWT_SECRET": "oee-uat-vercel-2026"
  }
}
