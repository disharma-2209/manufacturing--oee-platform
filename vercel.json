{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/dist/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "^/assets/(.*)", "dest": "/frontend/dist/assets/$1" },
    { "src": "^/fonts/(.*)", "dest": "/frontend/dist/fonts/$1" },
    { "src": "/(.*)", "dest": "/frontend/dist/index.html" }
  ],
  "env": {
    "NODE_ENV": "production",
    "VERCEL": "1",
    "DB_PATH": "/tmp/oee_platform.db",
    "JWT_SECRET": "oee-uat-vercel-2026"
  }
}
